# Copy to .env and edit. Every setting has a safe default; nothing here is required.
KESTREL_LLM_PROVIDER=fake            # fake | ollama | openai
KESTREL_OLLAMA_URL=http://localhost:11434
KESTREL_OLLAMA_MODEL=qwen2.5:1.5b-instruct
# Any OpenAI-compatible server works here, including a vLLM or SGLang server you run yourself:
#   vllm serve Qwen/Qwen2.5-1.5B-Instruct --port 8080  ->  KESTREL_OPENAI_BASE_URL=http://localhost:8080/v1
KESTREL_OPENAI_BASE_URL=http://localhost:8080/v1
KESTREL_OPENAI_API_KEY=not-needed-for-local
KESTREL_OPENAI_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Simulated latency of the fake LLM (lesson 3.2): prefill is cheap per token, decode is expensive.
KESTREL_FAKE_PREFILL_MS_PER_TOKEN=0.25
KESTREL_FAKE_DECODE_MS_PER_TOKEN=12
KESTREL_FAKE_MAX_CONCURRENCY=4         # requests the fake 'GPU' serves at once; others queue

# Caching (lesson 3.5)
KESTREL_CACHE_EXACT_ENABLED=false
KESTREL_CACHE_SEMANTIC_ENABLED=false
KESTREL_CACHE_SEMANTIC_THRESHOLD=0.92
KESTREL_CACHE_TTL_S=3600
