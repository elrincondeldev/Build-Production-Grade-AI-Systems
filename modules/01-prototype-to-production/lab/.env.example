# Copy to .env (never commit .env). Every setting uses the KESTREL_ prefix.
KESTREL_ENVIRONMENT=dev
KESTREL_LOG_LEVEL=INFO
KESTREL_LOG_JSON=true

# Model artifact
KESTREL_MODEL_DIR=artifacts/fraud-model
KESTREL_MODEL_VERSION=latest

# Decision thresholds (Module 4 shows how to choose these with a cost sweep)
KESTREL_REVIEW_THRESHOLD=0.30
KESTREL_DECLINE_THRESHOLD=0.80

# Online feature store / enrichment service (leave empty to skip enrichment)
KESTREL_ENRICHMENT_BASE_URL=http://127.0.0.1:8101
KESTREL_ENRICHMENT_TIMEOUT_S=0.3
KESTREL_ENRICHMENT_MAX_ATTEMPTS=3
KESTREL_ENRICHMENT_DEADLINE_S=1.0
KESTREL_RETRY_BUDGET_RATIO=0.1

# LLM used by /v1/explain: fake | ollama | openai
KESTREL_LLM_PROVIDER=fake
KESTREL_OLLAMA_BASE_URL=http://127.0.0.1:11434
KESTREL_OLLAMA_MODEL=qwen2.5:1.5b-instruct
KESTREL_OPENAI_BASE_URL=https://api.openai.com/v1
KESTREL_OPENAI_MODEL=gpt-4o-mini
# Secret: set it in your shell or a secret manager, never in a committed file.
# KESTREL_OPENAI_API_KEY=
